{
  "entities": {
    "User": {
      "title": "User",
      "description": "Individual user profile record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Full processing outcome and output archive record for OCR, Writing, and Voice modules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["ocr", "writer", "voice"] },
        "title": { "type": "string" },
        "preview": { "type": "string" },
        "timestamp": { "type": "number" },
        "fullData": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "title", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "User's saved history outcomes and full outputs"
    }
  }
}
