# ─── KothaLipi AI · Environment Variables ───────────────────────────────────
# Local development: create a `.env` (git-ignored) with these keys.
# cPanel production: set these in cPanel → Setup Node.js App → Environment
# Variables (do NOT commit real secrets, and do NOT use .env.example values).

# GEMINI_API_KEY: Required for all AI features (OCR, proofread, TTS, transcribe).
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (used for self-referential links).
APP_URL="https://kothalipi.devcenterpoint.com"

# NODE_ENV: Set to "production" so the server serves the built `dist/` bundle
# instead of the Vite dev middleware.
NODE_ENV="production"

# PORT: Usually injected automatically by cPanel/Passenger. Only set if needed.
# PORT=3000
